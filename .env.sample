########################################
## ADDITIONAL ENVIRONMENTAL VARIABLES ##
########################################

# (optional) Public URL of your instance, used for the sitemap and to allow that
# origin. The browser always calls the app's own origin, so leave this unset
# unless you're serving the app from a different hostname than users visit
# DL_BASE_URL='https://domains.example.com'

# (optional) Override the loopback URL used for internal server-to-server calls
# Defaults to localhost, and only needed if the app doesn't listen there
# DL_INTERNAL_BASE_URL='http://localhost:3000'

# (optional) Extra browser origins allowed to call the API, comma-separated.
# Only needed if the app is reached on an origin other than DL_BASE_URL
# DL_ALLOWED_ORIGINS='https://domains.example.com'

# (optional) To enable Captcha, add your Turnstile key
# DL_TURNSTILE_KEY=''

# (optional) To enable error tracking, add your GlitchTip or Sentry DSN
# DL_GLITCHTIP_DSN=''

# (optional) To enable hit counting, add your Plausible URL and site ID
# DL_PLAUSIBLE_URL=''
# DL_PLAUSIBLE_SITE=''

# (optional) To host your backend API somewhere else, configure the endpoints below
# DL_DOMAIN_INFO_API=''
# DL_DOMAIN_SUBS_API=''

# (optional) Use your own who-dat lookup instance (see: https://github.com/lissy93/who-dat)
# DL_WHO_DAT_URL='https://who-dat.as93.net'

# (optional) To disable write-methods being called from the UI (e.g. if no auth)
# DL_DISABLE_WRITE_METHODS='false'
#
# (optional, self-hosted) Number of concurrent domain checks (default: 10)
# DL_MONITOR_CONCURRENCY='10'

# (optional, self-hosted) The app runs its own scheduler, so no cron container is
# needed. Intervals are in minutes; set DL_DISABLE_SCHEDULER to run jobs yourself
# DL_DISABLE_SCHEDULER='false'
# DL_MONITOR_INTERVAL_MINUTES='15'
# DL_UPDATER_INTERVAL_MINUTES='1440'
# DL_REMINDERS_INTERVAL_MINUTES='1440'
# DL_CLEANUP_INTERVAL_MINUTES='10080'

# (optional, self-hosted) How many domains the updater refreshes per run
# DL_UPDATER_BATCH_SIZE='100'

# (optional) How long uptime history is kept, in days
# DL_UPTIME_RETENTION_DAYS='90'

# (optional) Order of WHOIS sources to try. RDAP first by default
# DL_WHOIS_PROVIDERS='rdap,whois-json,who-dat,native,whoisxml'

# (optional, self-hosted) Require a password to use the app, and a key for cron
# DL_AUTH_PASSWORD=''
# DL_API_KEY=''

# (optional, self-hosted) Path to the SQLite database, when Postgres is not
# configured. Defaults to ./data/domain-locker.db, and /data in Docker
# DL_SQLITE_PATH='./data/domain-locker.db'
#
# (optional, self-hosted) Set to `true` to disable SSRF protection for internal domains
# DL_DISABLE_SSRF_PROTECTION='true'
#
# (optional, self-hosted) Push notifications via an ntfy-compatible webhook.
# If your instance is private, authenticate with either a token or credentials
# NOTIFY_WEBHOOK_BASE='https://ntfy.sh'
# NOTIFY_WEBHOOK_TOPIC='my-topic-name'
# NOTIFY_WEBHOOK_TOKEN='tk_your-access-token'
# NOTIFY_WEBHOOK_USERNAME='your-username'
# NOTIFY_WEBHOOK_PASSWORD='your-password'
